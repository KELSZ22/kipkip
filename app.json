{
  "expo": {
    "name": "Kipkip",
    "slug": "kipkip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kipkip",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kelszdev.kipkip"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kelszdev.kipkip",
      "allowBackup": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kipkip uses Face ID to open private records. They stay on this phone."
        }
      ],
      "llama.rn",
      [
        "expo-notifications",
        {
          "color": "#0F6F66",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Kipkip links a contact only when you choose one for a Pramis. Contacts stay on this phone."
        }
      ],
      "./plugins/with-action-queries",
      "./plugins/with-whisper-proguard",
      [
        "expo-audio",
        {
          "microphonePermission": "Kipkip uses the microphone so you can speak a note. The recording stays on this phone.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "android",
      "ios"
    ]
  }
}
